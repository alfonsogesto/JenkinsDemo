pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Kubectl (cache)') {
      steps {
        sh '''
          set -e

          # Nos movemos a /tmp porque en el home a veces no hay permisos de escritura
          cd /tmp

          if [ ! -x "./kubectl" ]; then
            echo "Downloading kubectl (first time only)..."
            curl -fL --retry 3 --retry-delay 2 --max-time 120 \
              -o kubectl https://dl.k8s.io/release/v1.35.0/bin/linux/amd64/kubectl
            chmod +x kubectl
          else
            echo "Using cached kubectl"
          fi

          ./kubectl version --client
        '''
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          set -e
          cd /tmp

          ./kubectl apply -f $WORKSPACE/ActividadK8s/PythonProject2/k8s/ticket1/notas-ticket.yaml
        '''
      }
    }
  }
}
